#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network inet stream,
  capability net_bind_service,
  deny capability sys_admin,

  /app/** rw,
  /usr/local/bin/python* rix,
  /usr/local/lib/** r,
  /usr/lib/** r,
  /lib/** r,
  /etc/ld.so.cache r,
  /etc/localtime r,
  /etc/hosts r,
  /etc/resolv.conf r,

  deny /etc/** w,
  deny /var/** w,
  deny /bin/** x,
  deny /usr/bin/** x,
}
