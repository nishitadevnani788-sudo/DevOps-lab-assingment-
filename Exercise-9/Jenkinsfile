pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                dir('Exercise-9') {
                    sh '''
                        python3 --version
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir('Exercise-9') {
                    sh '.venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$WORKSPACE/Exercise-9/python-app-deploy"
                    cp "$WORKSPACE/Exercise-9/app.py" "$WORKSPACE/Exercise-9/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting deployed application...'
                sh '''
                    DEPLOY_DIR="$WORKSPACE/Exercise-9/python-app-deploy"

                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                        sleep 1
                    fi

                    nohup "$WORKSPACE/Exercise-9/.venv/bin/python" \
                        "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &

                    echo $! > "$DEPLOY_DIR/app.pid"
                    sleep 3

                    kill -0 "$(cat "$DEPLOY_DIR/app.pid")"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing the application...'
                dir('Exercise-9') {
                    sh '''
                        .venv/bin/python test_app.py
                        .venv/bin/python -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:5000/'); print(r.read().decode()); assert r.status == 200"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
